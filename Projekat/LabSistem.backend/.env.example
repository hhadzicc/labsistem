ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
CONNECTION_STRING=Host=localhost;Port=5432;Database=labsistem;Username=labsistem;Password=change-me
JWT_KEY=replace-with-at-least-32-random-characters
FRONTEND_BASE_URL=http://localhost:5173
RESEND_API_KEY=
FROM_EMAIL=
SEED_DEMO_USERS=true

# Optional public demo workspace. Keep disabled until a protected admin exists.
DEMO_MODE_ENABLED=false
DEMO_MODE_RESET_INTERVAL_MINUTES=60
DEMO_MODE_PROTECTED_ADMIN_EMAIL=admin@example.com
DEMO_MODE_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Production bootstrap account. Remove or disable after the first admin is created.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=Production Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
